# Copy this file to `.env` and adjust for your environment.
# Vite bakes these at BUILD time — change env → rebuild (`npm run build`) then redeploy dist.

# Backend origin — REQUIRED for production images (/files/...).
# Put YOUR live backend URL here (not localhost). Example:
# VITE_BACKEND_BASE=https://your-backend.example.com
VITE_BACKEND_BASE=http://localhost:5500

# Optional: full REST API base URL. Defaults to `${VITE_BACKEND_BASE}/api/v1`.
# Relative `/api/v1` works in Vite dev (proxy) or when nginx proxies /api on the frontend host.
# VITE_API_BASE_URL=/api/v1

# Optional: localStorage key used to persist the auth token. Defaults to "qayd_token".
# VITE_AUTH_TOKEN_KEY=qayd_token

# Google Identity Services (Sign in with Google) client ID. Must match the
# backend's GOOGLE_CLIENT_ID (same OAuth client, used to verify ID tokens).
VITE_GOOGLE_CLIENT_ID=
